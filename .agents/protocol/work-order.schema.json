{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BH2-4/agent-delivery-loop/blob/main/.agents/protocol/work-order.schema.json",
  "title": "Agent Delivery Loop Work Order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "revision",
    "objective",
    "out_of_scope",
    "acceptance_criteria",
    "allowed_paths",
    "worker_profile",
    "skill_ref",
    "stop_conditions",
    "limits"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "pattern": "^WO-[A-Z0-9-]{3,48}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "objective": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "out_of_scope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 },
      "maxItems": 30
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 },
      "maxItems": 30
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 },
      "maxItems": 100
    },
    "worker_profile": { "const": "claude-code-v1" },
    "skill_ref": {
      "type": "string",
      "pattern": "^\\.agents/policies/[A-Za-z0-9._/-]+/SKILL\\.md$"
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 },
      "maxItems": 30
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_turns", "timeout_seconds", "max_budget_usd"],
      "properties": {
        "max_turns": { "type": "integer", "minimum": 1, "maximum": 100 },
        "timeout_seconds": { "type": "integer", "minimum": 60, "maximum": 14400 },
        "max_budget_usd": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
      }
    }
  }
}
